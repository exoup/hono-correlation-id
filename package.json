{
  "name": "hono-correlation-id",
  "version": "1.0.6",
  "description": "Hono middleware to set correlation id across requests.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest --run",
    "build": "tsup ./src/index.ts --format esm,cjs --dts",
    "publint": "publint",
    "release": "pnpm build && pnpm test && pnpm publint && pnpm publish"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exoup/hono-correlation-id.git"
  },
  "homepage": "https://github.com/exoup/hono-correlation-id#readme",
  "keywords": [
    "hono",
    "correlation",
    "request",
    "id",
    "middleware"
  ],
  "author": "JosephY (https://github.com/exoup)",
  "license": "MIT",
  "peerDependencies": {
    "hono": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "hono": "^4.13.19",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "tsup": {
    "clean": true,
    "dts": true,
    "format": [
      "cjs",
      "esm"
    ],
    "skipNodeModulesBundle": true,
    "entryPoints": [
      "src/index.ts"
    ],
    "target": "es2020",
    "outDir": "dist",
    "entry": [
      "src/**/*.ts"
    ]
  }
}